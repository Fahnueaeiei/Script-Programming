# Copy to ".env" and fill in. NEVER commit .env
SENDER_EMAIL=your_gmail_address@gmail.com
SENDER_APP_PASSWORD=your_16_char_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Recipient for test emails
TEST_RECIPIENT_EMAIL=another_email@example.com

# Your identity (appears in every email / SMS)
STUDENT_NAME=Firstname
STUDENT_SURNAME=Lastname
STUDENT_ID=1234567890

# SMS via email gateway - optional, leave blank to skip
# carriers: att, verizon, tmobile, sprint, boost, cricket, us_cellular
TEST_SMS_PHONE_NUMBER=
TEST_SMS_CARRIER=
